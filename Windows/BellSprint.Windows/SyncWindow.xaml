<Window x:Class="BellSprint.Windows.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同步到其他天" Width="420" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" />
            <Button Content="同步" Click="Sync_Click" Background="#2563EB" Foreground="White" />
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="同步内容" Margin="0,0,0,5" />
            <ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="0,0,0,12">
                <ComboBoxItem Content="全部" Tag="All" />
                <ComboBoxItem Content="时间安排" Tag="Time" />
                <ComboBoxItem Content="课程安排" Tag="Courses" />
            </ComboBox>
            <TextBlock Text="目标日期" Margin="0,0,0,5" />
            <ListBox x:Name="TargetsList" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" Padding="4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
