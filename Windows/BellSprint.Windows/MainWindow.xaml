<Window x:Class="BellSprint.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BellSprint 上下课铃声" Width="1040" Height="760"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,1,0">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="每周课表" FontSize="18" FontWeight="SemiBold" Margin="8,8,8,12" />
                <ListBox x:Name="DaysList" SelectionChanged="DaysList_SelectionChanged"
                         DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="LaunchAtLoginCheck" Content="开机自启动" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="声音设置" Click="SoundSettings_Click" />
                        <Button Content="同步到其他天" Click="Sync_Click" />
                        <Button Content="保存" Click="Save_Click" Background="#2563EB" Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock x:Name="DayTitle" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <GroupBox Header="基本设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="启用当天" IsChecked="{Binding IsActive}" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                            <CheckBox Grid.Row="0" Grid.Column="2" Content="托盘显示课程" IsChecked="{Binding ShowCoursesInTray}" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="第一节课开始" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="最后一节课结束" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="每节课时长（分钟）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ClassDuration, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="默认课间（分钟）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding BreakDuration, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="预备铃提前（分钟）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PreBellMinutes, UpdateSourceTrigger=LostFocus}" LostFocus="SaveOnly_LostFocus" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="休息时间">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="午休" IsChecked="{Binding LunchBreak.IsEnabled}" Checked="ScheduleSetting_Changed" Unchecked="ScheduleSetting_Changed" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="开始" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding LunchBreak.StartText, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="结束" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding LunchBreak.EndText, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="时长（分钟）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="6" Width="90" HorizontalAlignment="Left" Text="{Binding LunchBreak.Duration, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />

                            <CheckBox Grid.Row="1" Grid.Column="0" Content="晚饭" IsChecked="{Binding DinnerBreak.IsEnabled}" Checked="ScheduleSetting_Changed" Unchecked="ScheduleSetting_Changed" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="开始" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DinnerBreak.StartText, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="结束" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding DinnerBreak.EndText, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />
                            <TextBlock Grid.Row="1" Grid.Column="5" Text="时长（分钟）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="6" Width="90" HorizontalAlignment="Left" Text="{Binding DinnerBreak.Duration, UpdateSourceTrigger=LostFocus}" LostFocus="ScheduleSetting_LostFocus" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="课程表">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="全部课程时长" VerticalAlignment="Center" Margin="8" />
                                    <TextBox x:Name="GlobalDurationBox" Width="55" Text="45" />
                                    <Button Content="应用" Click="ApplyGlobalDuration_Click" />
                                    <Button Content="添加课程" Click="AddCourse_Click" />
                                    <Button Content="删除选中" Click="DeleteCourse_Click" />
                                    <Button Content="一键生成" Click="Generate_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ConflictText" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <DataGrid x:Name="CoursesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                      SelectionMode="Single" CellEditEnding="CoursesGrid_CellEditEnding"
                                      MinHeight="220" MaxHeight="380">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="节次" Binding="{Binding Id}" IsReadOnly="True" Width="55" />
                                    <DataGridTextColumn Header="预备铃" Binding="{Binding PreBellText}" IsReadOnly="True" Width="75" />
                                    <DataGridTextColumn Header="开始" Binding="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="75" />
                                    <DataGridTextColumn Header="结束" Binding="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="75" />
                                    <DataGridTextColumn Header="时长" Binding="{Binding Duration, UpdateSourceTrigger=LostFocus}" Width="65" />
                                    <DataGridTextColumn Header="课间" Binding="{Binding BreakDuration, UpdateSourceTrigger=LostFocus}" Width="65" />
                                    <DataGridTextColumn Header="科目" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
